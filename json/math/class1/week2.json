            "correct_answer": 1,
            "worked_solution": {
              "steps": ["Start at 4", "Take away 1: count back one step", "4 \u2192 3", "Answer: 3"],
              "answer": "3",
              "explanation": "4 \u2212 1 = 3. Taking away one gives three."
