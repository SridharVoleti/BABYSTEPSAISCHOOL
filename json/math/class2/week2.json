            "id": "MATH2_W02_D1_H1",
            "type": "word_problem",
            "question": "Each box contains 6 chocolates. There are 5 boxes. How many chocolates are there altogether?",
            "correct_answer": 30,
            "worked_solution": {
              "steps": [
                "Boxes: 5",
                "Chocolates per box: 6",
                "Total = 5 \u00d7 6 = 30",
                "Check: 6+6+6+6+6 = 30"
              ],
              "answer": "30",
              "key_concepts": ["multiplication", "equal groups"],
              "explanation": "5 boxes \u00d7 6 chocolates = 30 chocolates."
            },
            "hint": "Equal groups mean we multiply. Boxes \u00d7 chocolates per box."
          }
        ]
      }
