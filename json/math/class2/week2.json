      "day": 1,
      "title": "Multiplication as Repeated Addition",
      "teaching_summary": "Multiplication is a shortcut for adding the same number many times. 3 \u00d7 4 means 4 + 4 + 4.",
      "worked_examples": [
        {
          "problem": "3 \u00d7 4 = ?",
          "solution_steps": ["3 groups of 4: 4 + 4 + 4", "Count: 8, 12", "Answer: 12"],
          "answer": "12"
        }
      ],
      "problems": {
        "easy": [
          {
            "id": "MATH2_W02_D1_E1",
            "type": "mcq",
            "question": "2 + 2 + 2 is the same as?",
            "options": ["2 \u00d7 2", "3 \u00d7 2", "2 \u00d7 3", "both B and C"],
            "correct_answer": 3,
            "worked_solution": {
              "steps": ["2 + 2 + 2 has 3 twos", "3 twos = 3 \u00d7 2 = 6", "Also written as 2 \u00d7 3 = 6"],
              "answer": "both B and C",
              "explanation": "Three 2s can be written as 3\u00d72 or 2\u00d73 (multiplication is commutative)."
            },
            "hint": "How many 2s are added? That count is one factor."
          },
          {
            "id": "MATH2_W02_D1_E2",
            "type": "mcq",
            "question": "5 + 5 + 5 = ?",
            "options": ["10", "15", "20", "25"],
            "correct_answer": 1,
            "worked_solution": {
              "steps": ["3 fives = 3 \u00d7 5 = 15"],
              "answer": "15",
              "explanation": "5 + 5 + 5 = 15. Three groups of five."
            },
            "hint": "Add 5 three times, or think 3 \u00d7 5."
          }
        ],
        "medium": [
          {
            "id": "MATH2_W02_D1_M1",
            "type": "numeric_fill",
            "question": "4 \u00d7 3 = __",
            "correct_answer": 12,
            "worked_solution": {
              "steps": ["4 groups of 3: 3+3+3+3", "3+3=6, 6+3=9, 9+3=12", "Answer: 12"],
              "answer": "12",
              "explanation": "4 \u00d7 3 = 12."
            },
            "hint": "Add 3 four times: 3+3+3+3."
          },
          {
            "id": "MATH2_W02_D1_M2",
            "type": "numeric_fill",
            "question": "How many total legs do 4 chairs have if each chair has 4 legs?",
            "correct_answer": 16,
            "worked_solution": {
              "steps": ["4 chairs, each with 4 legs", "4 \u00d7 4 = 16", "Answer: 16 legs"],
              "answer": "16",
              "explanation": "4 \u00d7 4 = 16 total legs."
