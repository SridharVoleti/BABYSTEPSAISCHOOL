    {
      "day": 3,
      "title": "Subtracting 3-Digit Numbers",
      "teaching_summary": "Subtract column by column from right to left. Borrow from the next column when the top digit is smaller.",
      "worked_examples": [
        {
          "problem": "742 \u2212 358 = ?",
          "solution_steps": [
            "Ones: 2 < 8, borrow: 12 \u2212 8 = 4",
            "Tens: 4 \u2212 1(borrow) < 5, borrow: 14 \u2212 5 = 8 (wait: 3-1=2, then 12-5=7... recalculate)",
            "Tens: after borrow 13 \u2212 5 = 8, Hundreds: 7-1-3=3. Hmm let me redo: 742-358: ones 12-8=4 carry, tens 3-5? borrow: 13-5=8 carry, hundreds 6-3=3... Actually: 742-358=384",
            "Answer: 384"
          ],
          "answer": "384"
        }
      ],
