        "hard": [
          {
            "id": "MATH3_W01_D3_H1",
            "type": "word_problem",
            "question": "A factory made 915 toys in January. In February they made 648 toys. How many more toys did they make in January than February?",
            "correct_answer": 267,
            "worked_solution": {
              "steps": [
