            "worked_solution": {
              "steps": ["4 hundreds = 400", "0 tens = 0", "9 ones = 9", "400 + 0 + 9 = 409"],
              "answer": "409",
              "explanation": "4 hundreds, 0 tens, 9 ones = 409."
            },
            "hint": "Hundreds digit first, tens next, ones last."
          }
        ],
        "medium": [
