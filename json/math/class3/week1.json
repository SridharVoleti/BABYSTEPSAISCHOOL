      "day": 1,
      "title": "3-Digit Place Value",
      "teaching_summary": "A 3-digit number has hundreds, tens, and ones. 347 = 3 hundreds + 4 tens + 7 ones = 300 + 40 + 7.",
      "worked_examples": [
        {
          "problem": "What is the value of digit 6 in 682?",
          "solution_steps": ["6 is in the hundreds place", "Value = 6 \u00d7 100 = 600"],
          "answer": "600"
        }
      ],
      "problems": {
        "easy": [
          {
            "id": "MATH3_W01_D1_E1",
            "type": "mcq",
            "question": "In 523, which digit is in the hundreds place?",
            "options": ["2", "3", "5", "52"],
            "correct_answer": 2,
            "worked_solution": {
              "steps": ["523: the leftmost digit is 5", "5 is in the hundreds place"],
              "answer": "5",
              "explanation": "In a 3-digit number, the leftmost digit is in the hundreds place."
