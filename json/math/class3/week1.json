    {
      "day": 2,
      "title": "Adding 3-Digit Numbers",
      "teaching_summary": "Add column by column: ones, then tens, then hundreds. Carry to the next column when a sum exceeds 9.",
      "worked_examples": [
        {
          "problem": "347 + 285 = ?",
          "solution_steps": [
            "Ones: 7 + 5 = 12. Write 2, carry 1",
            "Tens: 4 + 8 + 1 = 13. Write 3, carry 1",
            "Hundreds: 3 + 2 + 1 = 6",
            "Answer: 632"
          ],
          "answer": "632"
        }
      ],
      "problems": {
        "easy": [
          {
            "id": "MATH3_W01_D2_E1",
            "type": "mcq",
            "question": "What is 231 + 145?",
            "options": ["366", "376", "376", "386"],
            "correct_answer": 1,
            "worked_solution": {
              "steps": ["Ones: 1+5=6", "Tens: 3+4=7", "Hundreds: 2+1=3", "Answer: 376"],
              "answer": "376",
              "explanation": "231 + 145 = 376."
