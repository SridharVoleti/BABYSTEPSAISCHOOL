    {
      "day": 13,
      "micro_lesson_id": "SCI6_DLW_W03_L02_D13",
      "title": "Relation Between Venation and Roots",
      "duration_minutes": 15,

      "teaching_content": {
        "foundation": {
          "concept_text": "Plants with net-like veins usually have one main root."
        },
        "standard": {
          "concept_text": "Reticulate venation is generally associated with taproots. Parallel venation is associated with fibrous roots."
        },
        "advanced": {
          "concept_text": "This correlation provides predictive classification in botany."
        }
      },

