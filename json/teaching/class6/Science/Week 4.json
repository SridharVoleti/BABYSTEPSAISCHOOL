    {
      "day": 15,
      "micro_lesson_id": "SCI6_DLW_W03_L02_D15",
      "title": "Integrated Plant Classification",
      "duration_minutes": 15,

      "teaching_content": {
        "foundation": {
          "concept_text": "Plants can be grouped using leaves, roots and seeds together."
        },
        "standard": {
          "concept_text": "Monocots: parallel venation + fibrous roots + one cotyledon. Dicots: reticulate venation + taproot + two cotyledons."
        },
        "advanced": {
          "concept_text": "Multi-feature classification strengthens accuracy and scientific reasoning."
        }
      },

