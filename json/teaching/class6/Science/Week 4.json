    {
      "day": 14,
      "micro_lesson_id": "SCI6_DLW_W03_L02_D14",
      "title": "Dicots and Monocots – Seed Classification",
      "duration_minutes": 15,

      "teaching_content": {
        "foundation": {
          "concept_text": "Seeds may have one or two cotyledons."
        },
        "standard": {
          "concept_text": "Dicots have two cotyledons. Monocots have one cotyledon."
        },
        "advanced": {
          "concept_text": "Dicots typically show reticulate venation and taproots; monocots show parallel venation and fibrous roots."
        }
      },

