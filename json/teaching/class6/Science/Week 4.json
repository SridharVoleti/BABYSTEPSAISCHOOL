    {
      "day": 11,
      "micro_lesson_id": "SCI6_DLW_W03_L02_D11",
      "title": "Leaf Venation – Patterns of Veins",
      "duration_minutes": 15,

      "teaching_content": {
        "foundation": {
          "concept_text": "Leaves have thin lines called veins. The pattern of these veins is called venation."
        },
        "standard": {
          "concept_text": "Reticulate venation forms a net-like pattern. Parallel venation has veins running parallel."
        },
        "advanced": {
          "concept_text": "Venation is a structural feature used in plant classification and is often linked to root and seed type."
        }
      },

