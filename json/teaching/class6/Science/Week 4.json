    {
      "day": 12,
      "micro_lesson_id": "SCI6_DLW_W03_L02_D12",
      "title": "Types of Roots – Taproot and Fibrous Root",
      "duration_minutes": 15,

      "teaching_content": {
        "foundation": {
          "concept_text": "Some plants have one main root. Some have many thin roots."
        },
        "standard": {
          "concept_text": "Taproot system has one main root. Fibrous root system has many thin roots of similar size."
        },
        "advanced": {
          "concept_text": "Root structure provides anchorage and nutrient absorption and supports classification."
        }
      },

