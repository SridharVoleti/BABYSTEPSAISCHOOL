    {
      "day": 9,
      "micro_lesson_id": "SCI6_DLW_W02_L02_D9",
      "title": "Climbers and Creepers",
      "duration_minutes": 15,

      "teaching_content": {
        "foundation": {
          "concept_text": "Some plants cannot stand straight. They either climb or spread."
        },
        "standard": {
          "concept_text": "Climbers grow upward using support. Creepers spread along the ground."
        },
        "advanced": {
          "concept_text": "Weak stem morphology leads to adaptive growth strategies."
        }
      },

