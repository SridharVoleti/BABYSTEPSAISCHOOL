  "micro_lessons": [

    {
      "day": 6,
      "micro_lesson_id": "SCI6_DLW_W02_L02_D6",
      "title": "Why Do We Group Plants?",
      "duration_minutes": 15,

      "teaching_content": {
        "foundation": {
          "concept_text": "There are many types of plants. To study them easily, we group similar plants together."
        },
        "standard": {
          "concept_text": "Scientific grouping uses consistent structural features such as height, stem type and branching pattern."
        },
        "advanced": {
          "concept_text": "Classification must depend on stable morphological characteristics rather than temporary features."
        }
      },

