    {
      "day": 7,
      "micro_lesson_id": "SCI6_DLW_W02_L02_D7",
      "title": "Understanding Herbs",
      "duration_minutes": 15,

      "teaching_content": {
        "foundation": {
          "concept_text": "Herbs usually have soft, green stems."
        },
        "standard": {
          "concept_text": "Herbs are non-woody plants. Stem softness is the key feature."
        },
        "advanced": {
          "concept_text": "The absence of woody tissue differentiates herbs from shrubs and trees."
        }
      },

