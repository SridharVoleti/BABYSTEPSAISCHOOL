    {
      "day": 10,
      "micro_lesson_id": "SCI6_DLW_W02_L02_D10",
      "title": "Applying Plant Classification",
      "duration_minutes": 15,

      "teaching_content": {
        "foundation": {
          "concept_text": "Correct classification requires observing multiple features."
        },
        "standard": {
          "concept_text": "Height, stem type and branching pattern must be considered together."
        },
        "advanced": {
          "concept_text": "Scientific reasoning eliminates single-feature errors in classification."
        }
      },

