    {
      "day": 8,
      "micro_lesson_id": "SCI6_DLW_W02_L02_D8",
      "title": "Shrubs and Trees",
      "duration_minutes": 15,

      "teaching_content": {
        "foundation": {
          "concept_text": "Trees have one thick trunk. Shrubs have many stems near the ground."
        },
        "standard": {
          "concept_text": "Branching pattern and trunk structure differentiate shrubs and trees."
        },
        "advanced": {
          "concept_text": "Height alone is insufficient; branching origin is a diagnostic structural trait."
        }
      },

