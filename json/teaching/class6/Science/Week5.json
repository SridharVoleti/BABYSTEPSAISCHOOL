    {
      "day": 16,
      "micro_lesson_id": "SCI6_DLW_W04_L02_D16",
      "title": "Grouping Animals Based on Movement",
      "duration_minutes": 15,

      "teaching_content": {
        "foundation": {
          "concept_text": "Animals move in different ways. Some walk, some fly, some swim."
        },
        "standard": {
          "concept_text": "Animals can be grouped based on movement and body parts used, such as wings, fins and legs."
        },
        "advanced": {
          "concept_text": "Movement-based grouping reflects structural adaptations to habitat conditions."
        }
      },

