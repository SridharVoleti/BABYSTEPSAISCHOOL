    {
      "day": 18,
      "micro_lesson_id": "SCI6_DLW_W04_L02_D18",
      "title": "Adaptation – Surviving in Different Regions",
      "duration_minutes": 15,

      "teaching_content": {
        "foundation": {
          "concept_text": "Special features that help plants and animals survive are called adaptations."
        },
        "standard": {
          "concept_text": "Desert plants store water. Mountain trees have sloping branches to shed snow."
        },
        "advanced": {
          "concept_text": "Adaptations are structural or behavioural features shaped by environmental conditions."
        }
      },

