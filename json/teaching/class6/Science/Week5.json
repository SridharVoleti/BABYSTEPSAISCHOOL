    {
      "day": 20,
      "micro_lesson_id": "SCI6_DLW_W04_L02_D20",
      "title": "Habitat Destruction and Conservation",
      "duration_minutes": 15,

      "teaching_content": {
        "foundation": {
          "concept_text": "When habitats are damaged, plants and animals lose their homes."
        },
        "standard": {
          "concept_text": "Habitat destruction reduces biodiversity. Conservation protects living organisms."
        },
        "advanced": {
          "concept_text": "Conservation efforts maintain ecological balance and protect endangered species."
        }
      },

