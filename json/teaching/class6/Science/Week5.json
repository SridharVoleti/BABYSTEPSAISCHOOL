    {
      "day": 19,
      "micro_lesson_id": "SCI6_DLW_W04_L02_D19",
      "title": "Animal Adaptations – Camel and Mountain Goat",
      "duration_minutes": 15,

      "teaching_content": {
        "foundation": {
          "concept_text": "Animals also have special features to survive."
        },
        "standard": {
          "concept_text": "Desert camels have long legs and store fat in humps. Mountain goats have strong hooves for climbing."
        },
        "advanced": {
          "concept_text": "Animal morphology reflects environmental pressures such as heat, cold and terrain."
        }
      },

