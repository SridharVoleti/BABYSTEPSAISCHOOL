    {
      "day": 17,
      "micro_lesson_id": "SCI6_DLW_W04_L02_D17",
      "title": "Habitats – Where Do Plants and Animals Live?",
      "duration_minutes": 15,

      "teaching_content": {
        "foundation": {
          "concept_text": "The place where a plant or animal lives is called its habitat."
        },
        "standard": {
          "concept_text": "Habitats provide food, water, air and shelter. Habitats can be terrestrial or aquatic."
        },
        "advanced": {
          "concept_text": "Habitat determines survival conditions and shapes biodiversity of a region."
        }
      },

