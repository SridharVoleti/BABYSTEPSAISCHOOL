    {
      "day": 5,
      "micro_lesson_id": "SCI6_MLM_W02_L05_D5",
      "title": "Measuring Curved Lines and Indirect Measurement",
      "duration_minutes": 15,
      "teaching_content": {
        "foundation": {
          "concept_text": "Curved lines cannot be measured directly using a rigid scale."
        },
        "standard": {
          "concept_text": "Use thread or flexible tape to measure curved surfaces."
        },
        "advanced": {
          "concept_text": "Indirect measurement methods help estimate quantities like thickness of paper."
        }
      },
