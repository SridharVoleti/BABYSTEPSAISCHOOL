    {
      "day": 8,
      "micro_lesson_id": "SCI6_MLM_W02_L05_D8",
      "title": "Types of Motion",
      "duration_minutes": 15,
      "teaching_content": {
        "foundation": {
          "concept_text": "Objects move in different ways."
        },
        "standard": {
          "concept_text": "Motion can be linear, circular or oscillatory."
        },
        "advanced": {
          "concept_text": "Circular and oscillatory motions are periodic because they repeat after equal intervals of time."
        }
