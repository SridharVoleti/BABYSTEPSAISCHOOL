    {
      "day": 2,
      "micro_lesson_id": "SCI6_MLM_W02_L05_D2",
      "title": "SI Units of Length and Conversions",
      "duration_minutes": 15,
      "teaching_content": {
        "foundation": {
          "concept_text": "The SI unit of length is metre (m)."
        },
        "standard": {
          "concept_text": "1 km = 1000 m, 1 m = 100 cm, 1 cm = 10 mm."
        },
        "advanced": {
          "concept_text": "Unit conversion requires understanding of decimal shifts and unit hierarchy."
        }
      },
