    {
      "day": 4,
      "micro_lesson_id": "SCI6_MLM_W02_L05_D4",
      "title": "Correct Measurement Technique and Errors",
      "duration_minutes": 15,
      "teaching_content": {
        "foundation": {
          "concept_text": "Place the scale correctly along the object."
        },
        "standard": {
          "concept_text": "Eye position must be vertically above the reading to avoid parallax error."
        },
        "advanced": {
          "concept_text": "If zero mark is damaged, subtract initial reading from final reading to get correct length."
        }
      },
