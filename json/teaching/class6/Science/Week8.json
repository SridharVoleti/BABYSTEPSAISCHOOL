    {
      "day": 3,
      "micro_lesson_id": "SCI6_MLM_W02_L05_D3",
      "title": "Measuring Tools and Least Count",
      "duration_minutes": 15,
      "teaching_content": {
        "foundation": {
          "concept_text": "We use a scale, metre rod or measuring tape to measure length."
        },
        "standard": {
          "concept_text": "The smallest measurement readable on a scale is called its least count."
        },
        "advanced": {
          "concept_text": "Measurement accuracy depends on selecting appropriate tools and understanding least count."
        }
      },
