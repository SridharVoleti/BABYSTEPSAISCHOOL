  "micro_lessons": [

    {
      "day": 1,
      "micro_lesson_id": "SCI6_MLM_W02_L05_D1",
      "title": "Why Do We Need Standard Units?",
      "duration_minutes": 15,
      "teaching_content": {
        "foundation": {
          "concept_text": "People once measured length using handspan, foot or arm length."
        },
        "standard": {
          "concept_text": "Different people get different measurements using body parts because their sizes vary."
        },
        "advanced": {
          "concept_text": "A unit must be uniform and accepted universally to avoid variation in measurement."
        }
      },
