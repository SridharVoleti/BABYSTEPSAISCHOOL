    {
      "day": 6,
      "micro_lesson_id": "SCI6_MLM_W02_L05_D6",
      "title": "Reference Point and Describing Position",
      "duration_minutes": 15,
      "teaching_content": {
        "foundation": {
          "concept_text": "Distance is measured from a fixed point called a reference point."
        },
        "standard": {
          "concept_text": "The same object can appear closer or farther depending on the chosen reference point."
        },
        "advanced": {
          "concept_text": "Position is always described relative to a defined reference frame."
        }
      },
