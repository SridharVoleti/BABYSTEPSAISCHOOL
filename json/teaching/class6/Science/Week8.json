    {
      "day": 7,
      "micro_lesson_id": "SCI6_MLM_W02_L05_D7",
      "title": "Motion and Rest",
      "duration_minutes": 15,
      "teaching_content": {
        "foundation": {
          "concept_text": "An object is in motion if its position changes with time."
        },
        "standard": {
          "concept_text": "Motion and rest depend on the reference point."
        },
        "advanced": {
          "concept_text": "Motion is relative and depends on the observer’s frame of reference."
        }
      },
