    {
      "day": 3,
      "micro_lesson_id": "SCI6_CURIOSITY_CH01_W01_D3",
      "title": "The Scientific Method",
      "duration_minutes": 15,

      "revision_prompts": {
        "foundation": [
          "What is curiosity?",
          "What does observe mean?",
          "Why do we ask questions?"
        ],
        "standard": [
          "What makes a question scientific?",
          "How does observation help inquiry?"
        ],
        "advanced": [
          "How does a hypothesis connect observation and experiment?"
        ]
      },

      "teaching_content": {
        "foundation": {
          "concept_text": "The scientific method follows steps. First we observe. Then we ask a question. Next we form a hypothesis. After that we test it. Finally we conclude.",
          "pacing": "slow",
          "repetition_count": 3,
          "tts_rate": 0.7
        },
        "standard": {
          "concept_text": "The scientific method is a step-by-step way to solve problems. It includes observation, forming a hypothesis, conducting an experiment and drawing conclusions.",
          "pacing": "normal",
          "repetition_count": 2,
          "tts_rate": 0.9
        },
        "advanced": {
          "concept_text": "The scientific method ensures logical, repeatable and evidence-based investigation. Hypotheses must be testable, and conclusions must be based on results.",
          "pacing": "fast",
          "repetition_count": 1,
          "tts_rate": 1.1
        }
      },

      "vocabulary": [
        {"word": "hypothesis", "definition": "An educated guess.", "image_hint": "hypothesis.png"},
