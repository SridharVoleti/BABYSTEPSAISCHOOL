    {
      "day": 1,
      "micro_lesson_id": "SCI6_CURIOSITY_CH01_W01_D1",
      "title": "What is Science?",
      "duration_minutes": 15,

      "teaching_content": {
        "foundation": {
          "concept_text": "Science is not just a school subject. Science is a way of thinking about the world. When you look at something carefully and ask why it happens, you are thinking like a scientist. Curiosity makes us ask questions. If your pen stops writing and you try to find out why, that is science. Science helps us understand nature and everyday life.",
          "pacing": "slow",
          "repetition_count": 3,
          "tts_rate": 0.7
        },
        "standard": {
          "concept_text": "Science is a systematic way of understanding the natural world. It begins with curiosity and observation. When we notice something interesting, we ask questions. We investigate those questions and find answers based on evidence. Scientific knowledge grows as discoveries improve our understanding.",
          "pacing": "normal",
          "repetition_count": 2,
          "tts_rate": 0.9
        },
        "advanced": {
          "concept_text": "Science is an evolving and evidence-based process of inquiry. It builds reliable knowledge through observation, reasoning and experimentation. Scientific explanations may change when new evidence provides better understanding. This self-correcting nature makes science powerful.",
          "pacing": "fast",
          "repetition_count": 1,
          "tts_rate": 1.1
        }
      },

      "vocabulary": [
        {"word": "science", "definition": "Systematic study of the natural world.", "image_hint": "science.png"},
        {"word": "curiosity", "definition": "Desire to learn more.", "image_hint": "curiosity.png"},
        {"word": "discovery", "definition": "Finding new knowledge.", "image_hint": "discovery.png"}
      ],

      "dialogue_flow": [
        {"stage": "greeting", "text": "Hello! I am Dr. Saina. Let us explore what science really means."},
        {"stage": "concept", "text": "Today we understand science as a way of thinking."},
        {"stage": "activity", "text": "Let us connect important science words with their meanings."},
        {"stage": "wrapup", "text": "Wonderful start! Tomorrow we explore curiosity and questions."}
      ],

